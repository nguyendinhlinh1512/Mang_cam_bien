--cpu Cortex-M3
".\main.o"
".\dht11.o"
".\dht22.o"
".\tim2.o"
".\uart.o"
".\misc.o"
".\stm32f10x_flash.o"
".\stm32f10x_gpio.o"
".\stm32f10x_rcc.o"
".\stm32f10x_tim.o"
".\stm32f10x_usart.o"
".\gpio_stm32f10x.o"
".\startup_stm32f10x_md.o"
".\system_stm32f10x.o"
--strict --scatter ".\STM32_ESP32.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list ".\STM32_ESP32.map" -o .\STM32_ESP32.axf